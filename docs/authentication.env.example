# Copy values into an ignored root .env.local or deployment secret store.
# Reuse the existing DATABASE_URL and DATABASE_URL_UNPOOLED; do not create another pool.
AUTH_WEB_ORIGIN=http://localhost:5173
# Generate a random secret as described in AUTHENTICATION.md.
AUTH_JWT_SECRET=
# Local HTTP only. Production requires true and HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_SMTP_URL=smtp://localhost:1025
AUTH_EMAIL_FROM=ChainOps <no-reply@example.test>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5173/auth/github/callback
# Tests require a direct PostgreSQL connection supporting startup search_path.
# Prefer a dedicated Neon test branch, never a pooled connection here.
AUTH_TEST_DATABASE_URL=
